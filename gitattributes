# =========================================================================== #
#                         Universal .gitattributes                            #
#       https://gist.github.com/infiRD/13e68cb3b9f1e45d35d64574b688880e       #
# =========================================================================== #

# Auto detect text files and perform LF normalization
* text=auto

# Set line endings to LF, even on Windows
# See https://help.github.com/articles/dealing-with-line-endings/
# lf must be lowercase otherwise will be ignored !
*.sh            text   eol=lf
*.dircolors     text   eol=lf
*.profile       text   eol=lf
*.zshrc         text   eol=lf
*.bashrc        text   eol=lf
*.zsh-theme     text   eol=lf
*.bash_aliases  text   eol=lf
*.vimrc         text   eol=lf
sbt             text   eol=lf
gradlew         text   eol=lf

# Set line endings to CRLF, even on Linux
# See https://help.github.com/articles/dealing-with-line-endings/
# crlf must be lowercase otherwise will be ignored !
*.bat           text   eol=crlf
*.cmd           text   eol=crlf

# Ensure the following are treated as text
*.psm1          text
*.psd1          text

# Ensure the following are treated as binary
[Dd]esktop.ini  binary

# Archives
*.7z     filter=lfs diff=lfs merge=lfs -text
*.br     filter=lfs diff=lfs merge=lfs -text
*.gz     filter=lfs diff=lfs merge=lfs -text
*.tar    filter=lfs diff=lfs merge=lfs -text
*.zip    filter=lfs diff=lfs merge=lfs -text
*.jar    filter=lfs diff=lfs merge=lfs -text

# Documents
*.pdf    filter=lfs diff=lfs merge=lfs -text
*.vsd    filter=lfs diff=lfs merge=lfs -text

# Images
*.gif    filter=lfs diff=lfs merge=lfs -text
*.ico    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text

# Media
*.flac   filter=lfs diff=lfs merge=lfs -text

# Fonts
*.woff2  filter=lfs diff=lfs merge=lfs -text

# Other
*.exe    filter=lfs diff=lfs merge=lfs -text
*.axx    filter=lfs diff=lfs merge=lfs -text
